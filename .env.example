# ==========================================
# LocalFlow AI - Environment Variables
# ==========================================

# Supabase Configuration
# Replace these with your Supabase Project settings found in Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# Optional: Google Gemini API Key for AI Assistant
# If not configured, the system gracefully falls back to deterministic rule-based follow-up templates
VITE_GEMINI_API_KEY=your-gemini-api-key-here
